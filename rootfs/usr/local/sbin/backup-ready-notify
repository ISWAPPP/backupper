#!/usr/bin/env python3
from pathlib import Path
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile

UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")

def ready_archives(archives: Path, logs: Path, sent: set[str]) -> list[Path]:
    ready = []
    for archive in archives.glob('*.tar.gz'):
        ident = archive.name.removesuffix('.tar.gz')
        if (UUID.fullmatch(ident) and ident not in sent
                and archive.stat().st_size > 0
                and (logs / (ident + '.log')).is_file()
                and not (archives / (ident + '.status')).exists()):
            ready.append(archive)
    return sorted(ready)


def session_phase(ident: str, archives: Path) -> str:
    status = archives / (ident + '.status')
    if status.exists():
        return 'error' if status.read_text().strip() == 'error' else 'processing'
    archive = archives / (ident + '.tar.gz')
    return 'ready' if archive.is_file() and archive.stat().st_size > 0 else 'processing'


def discord_message(ident: str, phase: str, size: int = 0) -> str:
    url = f"https://@@PUBLIC_HOST@@/status/{ident}"
    if phase == 'ready':
        return f"✅ Архів готовий: {url} ({size / 1048576:.1f} MiB)"
    if phase == 'error':
        return f"❌ Архівація не вдалася: {url}"
    return f"⏳ Rsync завершено, архівація триває: {url}"


def send_discord(message: str, message_id: str | None = None) -> str:
    webhook = Path('/etc/backup-probe/discord-webhook').read_text().strip()
    if not webhook.startswith('https://discord.com/api/webhooks/') or '\n' in webhook or '"' in webhook:
        raise ValueError('Invalid webhook configuration')
    url = webhook + (f'/messages/{message_id}' if message_id else '?wait=true')
    fd, config = tempfile.mkstemp(dir='/var/lib/backup-probe', prefix='.discord-curl-')
    try:
        with os.fdopen(fd, 'w') as output:
            output.write(f'url = "{url}"\n')
        os.chmod(config, 0o600)
        payload = json.dumps({'content': message, 'allowed_mentions': {'parse': []}}).encode()
        args = ['curl', '-fsS', '--max-time', '20', '-K', config,
                '-H', 'Content-Type: application/json', '--data-binary', '@-']
        if message_id:
            args.extend(['-X', 'PATCH'])
        result = subprocess.run(args, input=payload, capture_output=True, timeout=30)
        if result.returncode:
            raise RuntimeError(f'Discord HTTP failure: {result.stderr.decode()[:250]}')
        returned = json.loads(result.stdout)
        if not returned.get('id') or (message_id and returned['id'] != message_id):
            raise RuntimeError('Discord response missing expected message ID')
        return returned['id']
    finally:
        os.unlink(config)


def save_state(path: Path, data: dict) -> None:
    fd, name = tempfile.mkstemp(dir=path.parent, prefix='.ready-')
    with os.fdopen(fd, 'w') as out:
        json.dump(data, out)
    os.chmod(name, 0o600)
    os.replace(name, path)


def main() -> None:
    archives = Path('/var/www/backups')
    logs = Path('/home/backupuser/tmp-logs')
    state = Path('/var/lib/backup-probe/ready-notified.json')
    lock = state.with_suffix('.lock')
    state.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with lock.open('a+') as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        old = json.loads(state.read_text()) if state.exists() else {}
        # Prior ready-only notifier stored a list of IDs without Discord message IDs.
        sessions = ({ident: {'phase': 'ready', 'message_id': None} for ident in old}
                    if isinstance(old, list) else old)
        for log in sorted(logs.glob('*.log')):
            ident = log.stem
            if not UUID.fullmatch(ident):
                continue
            current = sessions.get(ident)
            if current and current['phase'] in ('ready', 'error'):
                continue
            phase = session_phase(ident, archives)
            archive = archives / (ident + '.tar.gz')
            size = archive.stat().st_size if archive.is_file() else 0
            message = discord_message(ident, phase, size)
            if current is None:
                message_id = send_discord(message)
                sessions[ident] = {'phase': phase, 'message_id': message_id}
                save_state(state, sessions)
                print(f'created Discord message {message_id} for {ident}: {phase}')
            elif phase != current['phase']:
                send_discord(message, current['message_id'])
                current['phase'] = phase
                save_state(state, sessions)
                print(f'updated Discord message {current["message_id"]} for {ident}: {phase}')


if __name__ == '__main__':
    main()
